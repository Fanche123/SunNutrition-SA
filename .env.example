PORT=3000
ERP_DEPLOYMENT_MODE=local
ERP_HOST=127.0.0.1
# Lista separada por comas. Por defecto se permiten localhost y 127.0.0.1 con PORT.
ERP_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Limites seguros de la consola SQL de solo lectura.
ERP_SQL_TIMEOUT_MS=5000
ERP_SQL_SQLITE_BUDGET_MS=4000
ERP_SQL_CALLBACK_BUDGET=20000
ERP_SQL_PROGRESS_OPERATIONS=10000
ERP_SQL_MAX_OUTPUT_BYTES=20971520

# Umbrales de advertencia para all=true. No truncan resultados.
ERP_ALL_WARNING_ROWS=2500
ERP_ALL_WARNING_BYTES=2097152
ERP_ALL_WARNING_DURATION_MS=250

# Cuenta de servicio de Google Cloud con acceso de editor a la planilla.
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-cuenta@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Planilla y rango donde se agrega la fila.
INVENTORY_SPREADSHEET_ID=pegar_id_de_la_planilla
INVENTORY_SHEET_NAME=Inventario
INVENTORY_DATE_COLUMN=B
INVENTORY_EMPLOYEE_COLUMN=C
INVENTORY_DETAIL_SHEET_NAME=Detalle_Inventario

# Necesario para leer fotos de inventario.
OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-4o-mini

# Generación opcional de SQL de solo lectura desde Administración > Consultas SQL.
# La clave permanece en backend; si falta, la consola manual sigue disponible.
OPENAI_SQL_MODEL=gpt-5.6-terra
OPENAI_SQL_TIMEOUT_MS=15000
OPENAI_SQL_PROMPT_MAX_LENGTH=1000
OPENAI_SQL_MAX_OUTPUT_TOKENS=800
OPENAI_SQL_MAX_LENGTH=12000
OPENAI_SQL_RATE_LIMIT_PER_MINUTE=10
OPENAI_SQL_MAX_CONCURRENT=3
