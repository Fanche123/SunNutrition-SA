{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunnutrition.local/schemas/coordination/task.schema.json",
  "title": "ERP persistent coordination task",
  "description": "Contexto runtime de una tarea coordinada. Se almacena bajo .coordination/runtime y no se versiona.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "taskId",
    "createdAt",
    "updatedAt",
    "status",
    "sourceChat",
    "originalRequest",
    "objective",
    "initialDomain",
    "currentDomain",
    "initialPrompt",
    "historySummary",
    "nextRevision",
    "revisions",
    "observations",
    "decisions",
    "approvals",
    "transfers",
    "events"
  ],
  "properties": {
    "version": {
      "const": "2.0"
    },
    "taskId": {
      "$ref": "#/$defs/safeId"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "initialized",
        "initial_prompt_issued",
        "executing",
        "awaiting_review",
        "review_ready",
        "presented",
        "approved",
        "transferred",
        "blocked",
        "failed",
        "closed"
      ]
    },
    "sourceChat": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "originalRequest": {
      "$ref": "#/$defs/longText"
    },
    "objective": {
      "$ref": "#/$defs/longText"
    },
    "initialDomain": {
      "$ref": "#/$defs/domain"
    },
    "currentDomain": {
      "$ref": "#/$defs/domain"
    },
    "initialPrompt": {
      "$ref": "#/$defs/longText"
    },
    "historySummary": {
      "type": "string",
      "maxLength": 20000
    },
    "nextRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10001
    },
    "revisions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/revision"
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "approvals": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/approval"
      }
    },
    "transfers": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/transfer"
      }
    },
    "events": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullableHash": {
      "oneOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableDomain": {
      "oneOf": [
        {
          "$ref": "#/$defs/domain"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableRevision": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "domain": {
      "type": "string",
      "enum": [
        "arquitectura",
        "inventario",
        "compras",
        "ventas",
        "tesoreria",
        "rrhh",
        "reportes",
        "contabilidad",
        "administracion",
        "ui-ux",
        "base-de-datos",
        "bugs",
        "nuevas-funcionalidades",
        "analista-funcional"
      ]
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30000
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "submissionId",
        "domain",
        "status",
        "handoffHash",
        "proposalHash",
        "summary",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "submissionId": {
          "$ref": "#/$defs/safeId"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "status": {
          "type": "string",
          "enum": [
            "awaiting_review",
            "review_ready",
            "presented",
            "approved",
            "executing",
            "completed",
            "failed",
            "superseded",
            "closed"
          ]
        },
        "handoffHash": {
          "$ref": "#/$defs/nullableHash"
        },
        "proposalHash": {
          "$ref": "#/$defs/nullableHash"
        },
        "summary": {
          "type": "string",
          "maxLength": 8000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationId",
        "revision",
        "text",
        "createdAt",
        "status"
      ],
      "properties": {
        "observationId": {
          "$ref": "#/$defs/safeId"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "reviewed",
            "superseded"
          ]
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "proposalHash",
        "domain",
        "targetDomain",
        "prompt",
        "approvedAt",
        "approvedBy",
        "status"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "proposalHash": {
          "$ref": "#/$defs/hash"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "targetDomain": {
          "$ref": "#/$defs/domain"
        },
        "prompt": {
          "oneOf": [
            {
              "$ref": "#/$defs/longText"
            },
            {
              "type": "null"
            }
          ]
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": [
            "approved",
            "executing",
            "completed",
            "closed",
            "transferred"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "text",
        "createdAt",
        "domain",
        "revision"
      ],
      "properties": {
        "decisionId": {
          "$ref": "#/$defs/safeId"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "revision": {
          "$ref": "#/$defs/nullableRevision"
        }
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "proposalHash",
        "fromDomain",
        "toDomain",
        "prompt",
        "approvedAt",
        "status"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "proposalHash": {
          "$ref": "#/$defs/hash"
        },
        "fromDomain": {
          "$ref": "#/$defs/domain"
        },
        "toDomain": {
          "$ref": "#/$defs/domain"
        },
        "prompt": {
          "$ref": "#/$defs/longText"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "claimed",
            "executing",
            "completed"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "type",
        "at",
        "domain",
        "revision",
        "proposalHash",
        "summary"
      ],
      "properties": {
        "eventId": {
          "$ref": "#/$defs/safeId"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "domain": {
          "$ref": "#/$defs/nullableDomain"
        },
        "revision": {
          "$ref": "#/$defs/nullableRevision"
        },
        "proposalHash": {
          "$ref": "#/$defs/nullableHash"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    }
  }
}
