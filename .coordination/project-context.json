    "administracion": ".agents/administracion.md",
    "ui-ux": ".agents/ui-ux.md",
    "base-de-datos": ".agents/base-de-datos.md",
    "bugs": ".agents/bugs.md",
    "nuevas-funcionalidades": ".agents/nuevas-funcionalidades.md",
    "analista-funcional": ".agents/analista-funcional.md"
