      "selection": "full"
    },
    {
      "label": "AGENTE COORDINADOR",
      "path": ".agents/coordinador.md",
      "required": true,
      "selection": "full"
    },
    {
      "label": "OWNERSHIP",
      "path": ".agents/file-ownership.md",
      "required": true,
      "selection": "full"
    },
    {
      "label": "PROTOCOLO DE COORDINACIÓN",
      "path": "docs/coordination/PROTOCOL.md",
      "required": true,
      "selection": "relevant-sections"
    }
  ],
  "domainAgentFiles": {
